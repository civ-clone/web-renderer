  "families": {
    "base": {
      "land": "terrain/land",
      "ocean": "terrain/ocean"
    },
    "terrain": {
      "method": "bitmask",
      "neighbours": "edges",
      "sprite": "terrain/{terrain}_{dirs}",
      "isolated": "terrain/{terrain}",
      "join": "",
      "skip": ["Ocean"],
      "matches": {
        "River": ["River", "@water"]
      }
    },
    "coast": {
      "method": "corners",
      "neighbours": "all",
      "strip": {
        "sprite": "terrain/coast_sprite",
        "cell": 16,
        "quarter": 8
      },
      "order": ["w", "nw", "n", "ne", "e", "se", "s", "sw"]
    },
    "riverMouth": {
      "method": "edges",
      "neighbours": "edges",
      "sprite": "terrain/river_mouth_{dir}"
    },
    "irrigation": {
      "sprite": "improvements/irrigation"
    },
    "mine": {
      "sprite": "improvements/mine"
    },
    "pollution": {
      "sprite": "improvements/pollution"
    },
    "road": {
      "method": "edges",
      "neighbours": "all",
      "sprite": "improvements/road_{dir}",
      "isolated": {
        "dot": "#8c5828",
        "size": 2
      }
    },
    "railroad": {
      "method": "edges",
      "neighbours": "all",
      "sprite": "improvements/railroad_{dir}",
      "isolated": {
        "dot": "#000",
        "size": 2
      }
    },
    "fog": {
      "method": "edges",
      "neighbours": "edges",
      "sprite": "map/fog_{dir}"
    },
    "special": {
      "sprite": "terrain/{special}",
      "anchors": {
        "Shield": {
          "x": 4,
          "y": 4
        }
      }
    },
    "hut": {
      "sprite": "map/hut"
    }
  },
  "units": {
    "sprite": "units/{unit}",
    "colouring": {
      "mode": "replaceColours",
      "keys": ["#60E064", "#2C7800"]
    },
    "fortified": "map/fortify",
    "stackOffset": {
      "x": -1,
      "y": -1
    },
    "status": {
      "x": 0.5,
      "baseline": 0.75,
      "fontSize": 8
    }
  },
  "cities": {
    "mode": "box",
    "sprite": "map/city",
    "inset": 1,
    "occupied": "#000",
    "colouring": {
      "mode": "replaceColours",
      "keys": ["#000"],
      "colours": [1]
    },
    "labels": {
      "x": 0.5,
      "sizeBaseline": 0.75,
      "nameBaseline": 1.6,
      "fontSize": 8,
      "disorderIcon": {
        "x": 5,
        "y": 1
      }
    }
  }
