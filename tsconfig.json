{
  "compilerOptions": {
    "baseUrl": ".",
    "paths": { "@civ-clone/ui-*": ["packages/*"] },
    "noEmit": true,
    "esModuleInterop": true,
    "lib": ["dom", "dom.iterable", "es2022"],
    "module": "commonjs",
    "moduleResolution": "node",
    "resolveJsonModule": true,
    "skipLibCheck": true,
    "strict": true,
    "target": "ES2018"
  },
  "include": ["main.ts", "build.json.d.ts", "src/js/**/*", "packages/**/*"],
  "exclude": ["**/node_modules"]
}
