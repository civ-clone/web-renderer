    "test:join-city": "node tools/join-city.js",
    "test:asset-slices": "node tools/asset-slices.js",
    "test:changelog": "node tools/changelog.js",
    "test:cheats": "node tools/cheats.js",
    "test:citizens": "node tools/citizens.js",
    "test:city-screen": "node tools/city-screen.js",
    "test:city-names": "node tools/city-names.js",
    "test:civil-disorder": "node tools/civil-disorder.js",
    "test:diplomats": "node tools/diplomats.js",
    "test:conformance": "npm run build:generate-plugins-ts && node tools/conformance.js",
    "test:conformance:update": "npm run build:generate-plugins-ts && node tools/conformance.js --update",
    "test:hydration": "npm run build:generate-plugins-ts && node tools/hydration.js",
    "test:improvement-obsolete": "node tools/improvement-obsolete.js",
    "test:incremental-reconstitute": "node tools/incremental-reconstitute.js",
    "test:isolation": "npm run build:generate-plugins-ts && node tools/isolation.js",
    "test:transient": "npm run build:generate-plugins-ts && node tools/transient.js",
    "test:game-year": "node tools/game-year.js",
    "test:inject": "npm run build:generate-plugins-ts && node tools/inject.js",
    "test:minimap": "node tools/minimap.js",
    "test:map-navigation": "node tools/map-navigation.js",
    "test:patch-refs": "node tools/patch-refs.js",
    "test:diplomacy": "npm run build:generate-plugins-ts && node tools/diplomacy.js",
    "test:load": "npm run build:generate-plugins-ts && node tools/load.js",
    "test:save": "npm run build:generate-plugins-ts && node tools/save.js",
    "test:selection-window": "node tools/selection-window.js",
    "test:single-choice": "node tools/single-choice.js",
    "test:saved-game": "node tools/saved-game.js",
    "test:power": "node tools/power.js",
    "test:specialists": "node tools/specialists.js",
    "test:standing-orders": "node tools/standing-orders.js",
    "test:terrain-job": "node tools/terrain-job.js",
    "test:top-cities": "node tools/top-cities.js",
    "test:intelligence": "node tools/intelligence.js",
    "test:trade-routes": "node tools/trade-routes.js",
    "test:translations": "node tools/translations.js",
    "test:transport-requests": "node tools/transport-requests.js",
    "test:unit-action-prompts": "node tools/unit-action-prompts.js",
    "test:unit-actions": "node tools/unit-actions.js",
    "test:unit-status": "node tools/unit-status.js",
    "test:turn-handover": "node tools/turn-handover.js",
    "test:one-flush-per-action": "node tools/one-flush-per-action.js",
    "test:world-sizes": "node tools/world-sizes.js",
    "test:worked-tiles": "node tools/worked-tiles.js",
    "ts:compile": "tsc --build tsconfig.json",
    "watch": "node esbuild.js watch"
  },
  "civ-clone": {
    "excludes": [
      "civ1-asset-extractor"
    ]
  },
