  "names": {
    "terrain": {
      "Arctic": "glacier"
    },
    "special": {
      "Arctic:Seal": "glacier/ivory",
      "Desert:Oasis": "desert/oasis",
      "Forest:Game": "forest/pheasant",
      "Grassland:Shield": "grassland/resources",
      "Hills:Coal": "hills/coal",
