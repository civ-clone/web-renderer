      "Submarine": "submarine",
      "Swordman": "legion",
      "Tank": "armor",
      "Transport": "transport",
      "Trireme": "trireme",
      "Warrior": "warriors"
    }
  },
  "families": {
    "base": {
      "land": "terrain/{terrain}/base-0",
      "ocean": "terrain/ocean/base-0",
      "under": {
        "River": "Grassland"
      }
    },
    "terrain": {
      "method": "bitmask",
      "neighbours": "edges",
      "sprite": "terrain/{terrain}/{dirs}",
      "isolated": "terrain/{terrain}/isolated",
      "join": "-",
      "skip": [
        "Arctic",
        "Desert",
        "Grassland",
        "Jungle",
        "Ocean",
        "Plains",
        "Swamp",
        "Tundra"
      ],
      "matches": {
        "River": ["River", "@water"]
      }
    },
    "coast": {
      "method": "corners",
      "neighbours": "all",
      "sprite": "terrain/coast/{corner}-{bits}",
      "corners": {
        "n": {
          "at": {
            "x": 16,
            "y": 0
          },
          "neighbours": ["ne", "n", "nw"]
        },
        "e": {
          "at": {
            "x": 32,
            "y": 8
          },
          "neighbours": ["se", "e", "ne"]
        },
        "s": {
          "at": {
            "x": 16,
            "y": 16
          },
          "neighbours": ["sw", "s", "se"]
        },
        "w": {
          "at": {
            "x": 0,
            "y": 8
          },
          "neighbours": ["nw", "w", "sw"]
        }
      }
    },
    "riverMouth": {
      "method": "edges",
      "neighbours": "edges",
      "sprite": "terrain/river-mouth/{dir}"
    },
    "irrigation": {
      "sprite": "improvements/irrigation",
      "overTerrain": true
    },
    "mine": {
      "sprite": "improvements/mine"
    },
    "pollution": {
      "sprite": "improvements/pollution"
    },
    "road": {
      "method": "edges",
      "neighbours": "all",
      "sprite": "improvements/road/{dir}",
      "isolated": "improvements/road/isolated"
    },
    "railroad": {
      "method": "edges",
      "neighbours": "all",
      "sprite": "improvements/railroad/{dir}",
      "isolated": "improvements/railroad/isolated"
    },
    "special": {
      "sprite": "terrain/{special}"
    },
    "hut": {
      "sprite": "map/hut"
    }
  },
  "units": {
    "sprite": "units/{unit}",
    "anchor": {
      "x": 0,
      "y": -16
    },
    "colouring": {
      "mode": "overlay",
      "sprite": "units/shield",
      "keys": ["#ff0000"],
      "anchor": "shield",
      "stack": {
        "sprite": "units/shield-back",
        "offset": {
          "x": -4,
          "y": -4
        }
      }
    },
    "fortified": "map/fortify",
    "status": {
      "x": 0.5,
      "baseline": 0.75,
      "fontSize": 10
    }
  },
  "cities": {
    "mode": "styles",
    "sprite": "city/{style}/{walls}{size}",
    "anchor": {
      "x": 0,
      "y": -16
    },
    "styles": {
      "names": [
        "stone-bronze",
        "ancient-classical",
        "far-east",
        "medieval",
        "early-industrial",
        "modern",
        "modern-alt"
      ],
      "default": "ancient-classical",
      "civilizations": {
        "American": "ancient-classical",
        "Aztec": "stone-bronze",
        "Babylonian": "stone-bronze",
        "Chinese": "far-east",
        "Egyptian": "stone-bronze",
        "English": "medieval",
        "French": "medieval",
        "German": "medieval",
        "Greek": "ancient-classical",
        "Indian": "far-east",
