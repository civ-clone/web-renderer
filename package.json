{
  "name": "@civ-clone/web-renderer",
  "version": "0.1.0",
  "repository": "git@github.com:civ-clone/web-renderer.git",
  "keywords": [
    "typescript",
    "civilization"
  ],
  "author": "dom111 <dom111@users.noreply.github.com>",
  "license": "MIT",
  "scripts": {
    "build": "npm run prebuild && npm run esbuild:bundle",
    "build:dev": "npm run prebuild && npm run esbuild:bundle:dev",
    "build:generate-plugins-ts": "node buildPluginList.js",
    "build:generate-translations-ts": "node buildTranslationList.js",
    "build:generate-version-text": "echo '{\"version\": \"'$npm_package_version\\@$(git rev-parse --short HEAD)'\"}' > build.json",
    "civ": "node tools/civ",
    "esbuild:bundle": "node esbuild.js",
    "esbuild:bundle:dev": "node esbuild.js dev",
    "prebuild": "npm run build:generate-plugins-ts && npm run build:generate-translations-ts && npm run ts:compile && npm run prettier:format && npm run build:generate-version-text",
    "prettier:check": "prettier --config .prettierrc --check 'src/**/*.{ts,scss}'",
    "prettier:format": "prettier --config .prettierrc 'src/**/*.{ts,scss}' --write",
    "release:changelog": "node generate-changelog.mjs --release",
    "test": "npm run build:generate-plugins-ts && npm run build:generate-translations-ts && npm run ts:compile && npm run test:conformance && npm run test:hydration && npm run test:isolation && npm run test:transient && npm run test:inject && npm run test:save && npm run test:load && npm run test:saved-game && npm run test:translations && npm run test:changelog && npm run test:worked-tiles && npm run test:patch-refs && npm run test:map-navigation",
    "test:changelog": "node tools/changelog.js",
    "test:conformance": "npm run build:generate-plugins-ts && node tools/conformance.js",
    "test:conformance:update": "npm run build:generate-plugins-ts && node tools/conformance.js --update",
    "test:hydration": "npm run build:generate-plugins-ts && node tools/hydration.js",
    "test:isolation": "npm run build:generate-plugins-ts && node tools/isolation.js",
    "test:transient": "npm run build:generate-plugins-ts && node tools/transient.js",
    "test:inject": "npm run build:generate-plugins-ts && node tools/inject.js",
    "test:map-navigation": "node tools/map-navigation.js",
    "test:patch-refs": "node tools/patch-refs.js",
    "test:load": "npm run build:generate-plugins-ts && node tools/load.js",
    "test:save": "npm run build:generate-plugins-ts && node tools/save.js",
    "test:saved-game": "node tools/saved-game.js",
    "test:translations": "node tools/translations.js",
    "test:worked-tiles": "node tools/worked-tiles.js",
    "ts:compile": "tsc --build tsconfig.json",
    "watch": "node esbuild.js watch"
  },
  "civ-clone": {
    "excludes": [
      "civ1-asset-extractor"
    ]
  },
  "devDependencies": {
    "@types/feather-icons": "^4.29.1",
    "@types/marked": "^4.0.8",
    "@types/node": "^14.0.0",
    "esbuild": "^0.14.32",
    "esbuild-sass-plugin": "^2.4.0",
    "glob": "^13.0.6",
    "prettier": "^2.0.0",
    "sass": "^1.59.2",
    "typescript": "^4.0.0"
  },
  "dependencies": {
    "@civ-clone/civ1-asset-extractor": "github:civ-clone/civ1-asset-extractor",
    "@civ-clone/civ1-city": "github:civ-clone/civ1-city",
    "@civ-clone/civ1-city-happiness": "github:civ-clone/civ1-city-happiness",
    "@civ-clone/civ1-city-improvement": "github:civ-clone/civ1-city-improvement",
    "@civ-clone/civ1-civilization": "github:civ-clone/civ1-civilization",
    "@civ-clone/civ1-diplomacy": "github:civ-clone/civ1-diplomacy",
    "@civ-clone/civ1-game": "github:civ-clone/civ1-game",
    "@civ-clone/civ1-game-year": "github:civ-clone/civ1-game-year",
    "@civ-clone/civ1-goody-hut": "github:civ-clone/civ1-goody-hut",
    "@civ-clone/civ1-government": "github:civ-clone/civ1-government",
    "@civ-clone/civ1-player": "github:civ-clone/civ1-player",
    "@civ-clone/civ1-science": "github:civ-clone/civ1-science",
    "@civ-clone/civ1-spaceship": "github:civ-clone/civ1-spaceship",
    "@civ-clone/civ1-trade-rate": "github:civ-clone/civ1-trade-rate",
    "@civ-clone/civ1-treasury": "github:civ-clone/civ1-treasury",
    "@civ-clone/civ1-unit": "github:civ-clone/civ1-unit",
    "@civ-clone/civ1-wonder": "github:civ-clone/civ1-wonder",
    "@civ-clone/civ1-world": "github:civ-clone/civ1-world",
    "@civ-clone/core-ai-client": "^0.1.3",
    "@civ-clone/core-city": "^0.1.14",
    "@civ-clone/core-city-build": "^0.1.8",
    "@civ-clone/core-city-improvement": "^0.1.5",
    "@civ-clone/core-civilization": "^0.1.5",
    "@civ-clone/core-client": "^0.1.4",
    "@civ-clone/core-data-object": "^0.1.14",
    "@civ-clone/core-diplomacy": "^0.1.4",
    "@civ-clone/core-engine": "^0.1.4",
    "@civ-clone/core-game": "^0.1.1",
    "@civ-clone/core-game-year": "^0.1.3",
    "@civ-clone/core-goody-hut": "^0.1.6",
    "@civ-clone/core-player": "^0.1.8",
    "@civ-clone/core-player-world": "^0.1.10",
    "@civ-clone/core-registry": "^0.1.5",
    "@civ-clone/core-rule": "^0.1.4",
    "@civ-clone/core-save-game": "^0.1.1",
    "@civ-clone/core-science": "^0.1.5",
    "@civ-clone/core-spaceship": "^0.1.8",
    "@civ-clone/core-treasury": "^0.1.5",
    "@civ-clone/core-turn-based-game": "^0.1.6",
    "@civ-clone/core-unit": "^0.1.18",
    "@civ-clone/core-world": "^0.1.14",
    "@civ-clone/library-unit": "^0.1.4",
    "@civ-clone/simple-ai-client": "github:civ-clone/simple-ai-client",
    "@civ-clone/simple-world-generator": "github:civ-clone/simple-world-generator",
    "@civ-clone/simple-world-path": "github:civ-clone/simple-world-path",
    "@dom111/element": "^0.2.0",
    "@dom111/typed-event-emitter": "^0.1.2",
    "feather-icons": "^4.28.0",
    "i18next": "^22.4.14",
    "i18next-browser-languagedetector": "^7.0.1",
    "idb": "^7.1.1",
    "marked": "^4.2.5"
  }
}
