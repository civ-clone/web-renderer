        "Russian": "medieval",
        "Zulu": "stone-bronze",
        "Australian": "medieval",
        "Brazilian": "medieval",
        "Chukchi": "stone-bronze",
        "Ethiopian": "ancient-classical",
        "Inca": "stone-bronze",
        "Indonesian": "far-east",
        "Japanese": "far-east",
        "Khmer": "far-east",
        "Kongo": "stone-bronze",
        "Malian": "stone-bronze",
        "Sioux": "stone-bronze",
        "Viking": "medieval",
        "Barbarian": "stone-bronze"
      },
      "sizes": [1, 4, 8, 12],
      "walls": {
        "plain": "",
        "walled": "walled-"
      }
    },
    "colouring": {
      "mode": "overlay",
      "sprite": "city/flag",
      "keys": ["#f30000", "#a70000"],
      "anchor": "flag"
    },
    "labels": {
      "x": 0.5,
      "sizeBaseline": 0.75,
      "nameBaseline": 1.5,
      "fontSize": 10,
      "disorderIcon": {
        "x": 2,
        "y": 2
      },
      "size": "size"
    }
  }
